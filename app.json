{
  "expo": {
    "name": "FreshRoute",
    "slug": "freshroute-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freshroute.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FreshRoute needs your location to show nearby organic products and track deliveries.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FreshRoute needs your location to track delivery routes and provide real-time updates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "package": "com.freshroute.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      ["expo-location", 
        { 
          "locationAlwaysAndWhenInUsePermission": "Allow FreshRoute to use your location to set your delivery address."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/notification-icon.png",
          "color": "#16a34a"
        }
      ],
      "expo-secure-store"
    ]
  }
}
